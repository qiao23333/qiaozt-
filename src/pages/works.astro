---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { projects as fallbackProjects } from "@/config/projectsConfig";

// 作品的唯一数据来源是你的 GitHub 公开仓库：
// 新建仓库 → 作品页自动多一张卡片，无需再改样式或配置。
const GITHUB_USER = "qiao23333";

// 已知仓库的定制展示（名称/简介/图标），不在表里的新仓库会自动用仓库信息生成卡片。
const repoOverrides: Record<string, { name: string; description: string; icon: string; accent: string; tags: string[] }> = {
	SnapSort: {
		name: "SnapSort",
		description: "图片分类整理工具，让散落无序的素材图按规则批量归类，把整理这件事变简单。",
		icon: "material-symbols:photo-library",
		accent: "#8b5cf6",
		tags: ["工具", "图片整理", "Python"],
	},
	"qiaozt-": {
		name: "乌鹊南飞 · 个人站",
		description: "本网站：基于 Astro 的个人世界，作品、文章与创作都会沉淀在这里。",
		icon: "material-symbols:article-rounded",
		accent: "#06b6d4",
		tags: ["网站", "Astro", "内容"],
	},
};

// 未知语言仓库默认用的图标（内置图标，本地构建无需联网）
const DEFAULT_ICON = "material-symbols:folder-open-rounded";

const languageTone: Record<string, { accent: string }> = {
	Python: { accent: "#8b5cf6" },
	TypeScript: { accent: "#3b82f6" },
	JavaScript: { accent: "#eab308" },
	Astro: { accent: "#f97316" },
	HTML: { accent: "#f97316" },
	CSS: { accent: "#06b6d4" },
	Shell: { accent: "#22c55e" },
};
type Cards = {
	name: string;
	description: string;
	icon: string;
	accent: string;
	tags: string[];
	githubUrl: string;
};

let cards: Cards[] = [];
let fromGitHub = false;
try {
	const res = await fetch(
		`https://api.github.com/users/${GITHUB_USER}/repos?sort=updated&per_page=50`,
		{
			headers: { "User-Agent": "trae", Accept: "application/vnd.github+json" },
			signal: AbortSignal.timeout(8000),
		},
	);
	if (res.ok) {
		const data = (await res.json()) as Array<{
			name: string;
			fork: boolean;
			size: number;
			description: string | null;
			language: string | null;
			html_url: string;
		}>;
		const list = data
			.filter((r) => !r.fork)
			.filter((r) => r.name && r.name.trim() !== "-")
			.filter((r) => r.size > 0 || r.description);
		cards = list.map((r) => {
			const over = repoOverrides[r.name];
			const accent =
				languageTone[r.language ?? ""]?.accent ?? "#06b6d4";
			return {
				name: over?.name ?? r.name,
				description:
					over?.description ?? (r.description || "一个公开的 GitHub 仓库。"),
				icon: over?.icon ?? DEFAULT_ICON,
				accent: over?.accent ?? accent,
				tags: over?.tags ?? [r.language ?? "GitHub"],
				githubUrl: r.html_url,
			};
		});
		fromGitHub = cards.length > 0;
	}
} catch {
	// 拉取失败时回退到本地配置
}
if (!fromGitHub) {
	cards = fallbackProjects.map((p) => ({ ...p, githubUrl: p.githubUrl }));
}
const projectCount = cards.length;
---

<MainGridLayout title="作品" description="我的项目与作品集">
	<section class="works-page">
		<header class="works-hero">
			<div>
				<div class="works-kicker">
					<Icon is:inline name="material-symbols:folder" />
					<span>my projects</span>
				</div>
				<h1>作品 / 项目</h1>
				<p>我做过的产品、工具与个人作品。点击卡片可直接跳转到对应 GitHub 仓库。</p>
			</div>
			<div class="works-stats" aria-label="作品统计">
				<div>
					<strong>{projectCount}</strong>
					<span>项目</span>
				</div>
			</div>
		</header>

		<div class="works-grid">
				{
					cards.map((project) => (
					<a
						class="project-card"
						href={project.githubUrl}
						target="_blank"
						rel="noopener noreferrer"
						style={`--project-accent: ${project.accent}`}
						aria-label={`访问 ${project.name} 仓库`}
					>
						<Icon
							is:inline
							name={project.icon}
							class="project-card-watermark"
							aria-hidden="true"
						/>
						<div>
							<div class="project-card-top">
								<div class="project-icon">
									<Icon is:inline name={project.icon} />
								</div>
								<div class="project-badge-row">
									<span class="project-badge">GitHub 项目</span>
									<Icon
										is:inline
										name="fa7-solid:arrow-up-right-from-square"
										class="project-external"
									/>
								</div>
							</div>
							<h3>{project.name}</h3>
							<p>{project.description}</p>
						</div>
						<div class="project-tags">
							{
								project.tags.map((tag) => (
									<span>{tag}</span>
								))
							}
						</div>
					</a>
				))
			}
		</div>
	</section>
</MainGridLayout>

<style>
	.works-page {
		width: 100%;
		position: relative;
		z-index: 1;
		--works-text-90: rgb(0 0 0 / 0.9);
		--works-text-50: rgb(0 0 0 / 0.5);
		--works-text-30: rgb(0 0 0 / 0.3);
	}

	:global(:root.dark) .works-page {
		--works-text-90: rgb(255 255 255 / 0.9);
		--works-text-50: rgb(255 255 255 / 0.5);
		--works-text-30: rgb(255 255 255 / 0.3);
	}

	.works-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1.25rem;
		align-items: end;
		margin-bottom: 1.25rem;
		padding: 1.5rem;
		border-radius: var(--radius-large);
		background: color-mix(in oklab, var(--card-bg) 80%, transparent);
		border: 1px solid color-mix(in oklab, var(--line-divider) 75%, transparent);
		backdrop-filter: blur(18px);
	}

	.works-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin-bottom: 0.75rem;
		padding: 0.35rem 0.65rem;
		border-radius: 0.5rem;
		color: var(--primary);
		background: color-mix(in oklab, var(--primary) 12%, transparent);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.works-hero h1 {
		margin: 0;
		font-size: clamp(1.75rem, 3vw, 2.75rem);
		line-height: 1.15;
		font-weight: 800;
		color: var(--works-text-90);
	}

	.works-hero p {
		max-width: 42rem;
		margin: 0.75rem 0 0;
		color: var(--works-text-50);
		line-height: 1.75;
	}

	.works-stats {
		display: grid;
		grid-template-columns: repeat(1, minmax(4.25rem, 1fr));
		gap: 0.55rem;
		min-width: 6rem;
	}

	.works-stats div {
		padding: 0.75rem 0.85rem;
		text-align: center;
		border-radius: 0.6rem;
		background: color-mix(in oklab, var(--card-bg) 65%, transparent);
		border: 1px solid color-mix(in oklab, var(--line-divider) 65%, transparent);
	}

	.works-stats strong {
		display: block;
		font-size: 1.35rem;
		line-height: 1;
		color: var(--works-text-90);
	}

	.works-stats span {
		display: block;
		margin-top: 0.35rem;
		font-size: 0.75rem;
		color: var(--works-text-50);
	}

	.works-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16.5rem, 1fr));
		gap: 1rem;
	}

	.project-card {
		min-height: 13.4rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1rem;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 1.1rem;
		border-radius: 1.05rem;
		text-decoration: none;
		color: inherit;
		background:
			linear-gradient(
				145deg,
				color-mix(in oklab, var(--card-bg) 96%, transparent),
				color-mix(in oklab, var(--card-bg) 76%, transparent)
			),
			color-mix(in oklab, var(--card-bg) 72%, transparent);
		border: 1px solid color-mix(in oklab, var(--line-divider) 82%, transparent);
		backdrop-filter: blur(16px);
		box-shadow:
			0 0.7rem 1.7rem rgb(24 50 77 / 0.06),
			inset 0 1px 0 rgb(255 255 255 / 0.58);
		transition:
			transform 0.32s cubic-bezier(0.2, 0.78, 0.2, 1),
			background 0.32s ease,
			border-color 0.32s ease,
			box-shadow 0.32s ease;
	}

	.project-card > * {
		position: relative;
		z-index: 1;
	}

	.project-card-watermark {
		position: absolute !important;
		z-index: 0 !important;
		top: 3.1rem;
		right: 0.65rem;
		width: 6rem;
		height: 6rem;
		padding: 1.05rem;
		border: 1px solid color-mix(in oklab, var(--project-accent) 18%, transparent);
		border-radius: 1.55rem 1.55rem 0.45rem 1.55rem;
		color: var(--project-accent);
		background: color-mix(in oklab, var(--project-accent) 5%, transparent);
		opacity: 0.16;
		transform: rotate(-9deg);
		filter: drop-shadow(0 0.65rem 0.8rem color-mix(in oklab, var(--project-accent) 12%, transparent));
		transition:
			opacity 0.32s ease,
			transform 0.48s cubic-bezier(0.2, 0.78, 0.2, 1),
			filter 0.32s ease;
	}

	.project-card::before {
		content: "";
		position: absolute;
		z-index: 0;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(
				12rem 9rem at 105% -12%,
				color-mix(in oklab, var(--project-accent) 25%, transparent),
				transparent 68%
			),
			linear-gradient(
				120deg,
				transparent 48%,
				color-mix(in oklab, var(--project-accent) 7%, transparent) 100%
			);
		opacity: 0.9;
		transform: scale(1);
		transform-origin: right top;
		transition: transform 0.55s cubic-bezier(0.2, 0.78, 0.2, 1);
	}

	.project-card::after {
		content: "";
		position: absolute;
		z-index: 0;
		right: -1.65rem;
		bottom: -2.05rem;
		width: 9rem;
		height: 8.8rem;
		pointer-events: none;
		background-image: radial-gradient(
			circle,
			color-mix(in oklab, var(--project-accent) 44%, transparent) 0.75px,
			transparent 0.9px
		);
		background-size: 0.7rem 0.7rem;
		mask-image: linear-gradient(135deg, transparent 0%, #000 48%, #000 100%);
		opacity: 0.38;
		transform: rotate(-8deg);
		transition: opacity 0.32s ease, transform 0.55s cubic-bezier(0.2, 0.78, 0.2, 1);
	}

	.project-card:hover {
		transform: translate3d(0, -0.38rem, 0);
		background: color-mix(in oklab, var(--card-bg) 96%, transparent);
		border-color: color-mix(in oklab, var(--project-accent) 58%, var(--line-divider));
		box-shadow:
			0 1.15rem 2.6rem color-mix(in oklab, var(--project-accent) 20%, transparent),
			inset 0 1px 0 rgb(255 255 255 / 0.72);
	}

	.project-card:hover::before {
		transform: scale(1.12) translate(-0.25rem, 0.15rem);
	}

	.project-card:hover::after {
		opacity: 0.66;
		transform: rotate(-3deg) translate(-0.35rem, -0.25rem);
	}

	.project-card:hover .project-card-watermark {
		opacity: 0.26;
		transform: rotate(-3deg) translate(-0.25rem, -0.15rem);
		filter: drop-shadow(0 0.85rem 1rem color-mix(in oklab, var(--project-accent) 19%, transparent));
	}

	.project-card-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		position: relative;
		gap: 0.85rem;
		margin-bottom: 1.05rem;
	}

	.project-card-top::after {
		content: "";
		position: absolute;
		left: 0;
		bottom: -0.58rem;
		width: min(6.8rem, 44%);
		height: 1px;
		background: linear-gradient(
			90deg,
			var(--project-accent),
			color-mix(in oklab, var(--project-accent) 10%, transparent)
		);
		opacity: 0.58;
	}

	.project-icon {
		width: 2.85rem;
		height: 2.85rem;
		display: grid;
		place-items: center;
		flex: 0 0 auto;
		position: relative;
		overflow: hidden;
		border-radius: 0.85rem 0.85rem 0.85rem 0.3rem;
		color: var(--project-accent);
		background:
			linear-gradient(
				135deg,
				color-mix(in oklab, var(--project-accent) 26%, var(--card-bg)),
				color-mix(in oklab, var(--project-accent) 8%, var(--card-bg))
			),
			var(--card-bg);
		border: 1px solid color-mix(in oklab, var(--project-accent) 34%, transparent);
		box-shadow:
			0 0.55rem 1.1rem color-mix(in oklab, var(--project-accent) 14%, transparent),
			inset 0 1px 0 rgb(255 255 255 / 0.52);
		font-size: 1.35rem;
		transition: transform 0.32s cubic-bezier(0.2, 0.78, 0.2, 1), box-shadow 0.32s ease;
	}

	.project-icon::after {
		content: "";
		position: absolute;
		inset: -30% 35% 42% -60%;
		background: rgb(255 255 255 / 0.46);
		transform: rotate(28deg);
		pointer-events: none;
	}

	.project-card:hover .project-icon {
		transform: translateY(-0.12rem) rotate(-4deg);
		box-shadow:
			0 0.75rem 1.3rem color-mix(in oklab, var(--project-accent) 24%, transparent),
			inset 0 1px 0 rgb(255 255 255 / 0.66);
	}

	.project-badge-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.project-badge {
		padding: 0.3rem 0.55rem;
		border-radius: 999px;
		color: var(--project-accent);
		background: color-mix(in oklab, var(--project-accent) 13%, transparent);
		border: 1px solid color-mix(in oklab, var(--project-accent) 24%, transparent);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.38);
		font-size: 0.72rem;
		font-weight: 800;
		white-space: nowrap;
	}

	.project-external {
		color: var(--works-text-30);
		font-size: 0.82rem;
		transition: color 0.2s ease, transform 0.28s cubic-bezier(0.2, 0.78, 0.2, 1);
	}

	.project-card:hover .project-external {
		color: var(--project-accent);
		transform: translate(0.12rem, -0.12rem);
	}

	.project-card h3 {
		margin: 0;
		font-size: 1.08rem;
		line-height: 1.35;
		color: var(--works-text-90);
		font-weight: 850;
		letter-spacing: -0.01em;
	}

	.project-card p {
		margin: 0.5rem 0 0;
		color: var(--works-text-50);
		font-size: 0.9rem;
		line-height: 1.7;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.1rem;
		padding-top: 0.82rem;
		border-top: 1px solid color-mix(in oklab, var(--line-divider) 58%, transparent);
	}

	.project-tags span {
		display: inline-flex;
		align-items: center;
		min-height: 1.7rem;
		padding: 0.28rem 0.5rem;
		border-radius: 999px;
		color: var(--works-text-50);
		background: color-mix(in oklab, var(--card-bg) 72%, transparent);
		border: 1px solid color-mix(in oklab, var(--line-divider) 58%, transparent);
		font-size: 0.72rem;
		font-weight: 700;
		transition: color 0.25s ease, border-color 0.25s ease, background 0.25s ease;
	}

	.project-card:hover .project-tags span {
		color: color-mix(in oklab, var(--project-accent) 62%, var(--works-text-90));
		background: color-mix(in oklab, var(--project-accent) 8%, var(--card-bg));
		border-color: color-mix(in oklab, var(--project-accent) 24%, var(--line-divider));
	}

	@media (prefers-reduced-motion: reduce) {
		.project-card,
		.project-card::before,
		.project-card::after,
		.project-card-watermark,
		.project-icon,
		.project-external,
		.project-tags span {
			transition: none;
		}
	}

	@media (max-width: 767px) {
		.works-hero {
			grid-template-columns: 1fr;
			padding: 1.1rem;
		}

		.works-stats {
			min-width: 0;
			width: 100%;
		}

		.works-grid {
			grid-template-columns: 1fr;
		}
	}
</style>